FROM python:3.11-slim
ARG DEBIAN_MIRROR=https://deb.debian.org
RUN sed -i "s|http://deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources && apt-get -o Acquire::Retries=1 -o Acquire::https::Timeout=30 update && apt-get install -y --no-install-recommends git ripgrep coreutils && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir pytest==8.3.5
ENV PYTHONUTF8=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
